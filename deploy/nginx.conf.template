# Only the selected gateway may supply the canonical client address.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Real-IP;
log_format client '$remote_addr peer=$realip_remote_addr "$request" $status';
map $arg_grant_type $login_key {
  default $binary_remote_addr;
  refresh_token "";
}
map $arg_grant_type $refresh_key {
  default "";
  refresh_token $binary_remote_addr;
}
limit_req_zone $login_key zone=login:10m rate=10r/m;
limit_req_zone $refresh_key zone=refresh:10m rate=150r/m;
server {
  listen 8080;
  access_log /var/log/nginx/access.log client;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 64k;
  server_tokens off;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  location = /health { access_log off; return 200 'ok'; }
  location ^~ /api/auth/v1/admin { return 404; }
  location = /api/auth/v1/token {
    limit_req zone=login burst=10 nodelay;
    limit_req zone=refresh burst=30 nodelay;
    limit_req_status 429;
    proxy_pass http://auth:9999/token;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location /api/auth/v1/ {
    proxy_pass http://auth:9999/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location /api/rest/v1/ {
    proxy_pass http://rest:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location = /index.html { expires -1; }
  location /assets/ { expires 1y; add_header Cache-Control 'public, immutable'; try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}
