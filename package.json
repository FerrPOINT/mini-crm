    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.11",
    "lucide-react": "1.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.5",
    "react-router": "8.5.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
